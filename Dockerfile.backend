# ==========================================
# 1. ETAP: DEPENDENCIES (Wspólny dla dev i prod)
# ==========================================
FROM node:22-slim AS deps
WORKDIR /app

# Ustawiamy globalny store pnpm, aby współpracował z naszymi wolumenami
ENV PNPM_HOME="/pnpm-store"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    build-essential

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY frontend/package.json ./frontend/package.json
COPY backend/package.json ./backend/package.json
COPY packages/shared/package.json ./packages/shared/package.json
COPY packages/shared/tsconfig.json ./packages/shared/tsconfig.json

RUN pnpm install --frozen-lockfile --ignore-scripts
RUN pnpm rebuild @nestjs/core @swc/core better-sqlite3

COPY packages/shared/src ./packages/shared/src
RUN pnpm --filter shared build

# ==========================================
# 2. ETAP: DEVELOPMENT
# ==========================================
FROM deps AS dev
WORKDIR /app/backend
EXPOSE 3001
CMD ["pnpm", "start:dev"]

# ==========================================
# 3. ETAP: BUILD (Tylko do produkcji)
# ==========================================
FROM deps AS build
WORKDIR /app
COPY backend ./backend
WORKDIR /app/backend
RUN pnpm build

# ==========================================
# 4. ETAP: DEPLOY (Przygotowanie odchudzonego buildu)
# ==========================================
FROM deps AS deploy
WORKDIR /app
COPY backend ./backend
RUN pnpm --filter backend --prod deploy --legacy /prod/backend

# ==========================================
# 5. ETAP: PRODUCTION (Finalny, lekki obraz)
# ==========================================
FROM node:22-slim AS prod
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@11.7.0 --activate
# Kopiujemy tylko to, co wygenerował etap deploy (bez pnpm-store i devDependencies!)
COPY --from=deploy /prod/backend ./
COPY --from=build /app/backend/dist ./dist
COPY --from=build /app/backend/drizzle ./drizzle
EXPOSE 3000
CMD ["pnpm", "start:prod"]
